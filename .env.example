# MongoDB Atlas Database Credentials
MONGODB_USER=FormFarm
MONGODB_PASS=your_mongodb_password
MONGODB_ATLAS_DRIVER_CONNECTION=mongodb+srv://FormFarm:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=FormFarmDB

# Application & Auth Secrets
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Global Telegram Bot Token fallback
# (If set, members can receive Telegram notifications through your central bot by entering just their Chat ID,
# or they can provide their own Bot Token in their Panel Settings for 100% private isolation)
TELEGRAM_BOT_TOKEN=
